<!--
	il DOCTYPE indica che il file web.xml sta seguendo la versione 2.3 del DTD per le applicazioni web java
	-Servlet: I componenti che rispondono alle richieste HTTP.
	-Filtri: I componenti che possono intercettare le richieste prima che raggiungano i servlet.
	-Listener: Oggetti che vengono eseguiti quando l'applicazione viene avviata o arrestata.
	-Mappatura di URL: Le rotte (gli URL) a cui rispondono i servlet.
-->
<!DOCTYPE web-app PUBLIC "-//Sun Microsystems, Inc.//DTD Web Application 2.3//EN" "http://java.sun.com/dtd/web-app_2_3.dtd" >

<!--
	web-app racchiude la configurazione dell'intera applicazione web
-->
<web-app>
	<!-- 
		Nome dell'applicazione web visualizzato nei file di log e nelle interfacce di amministrazione del server
	-->
	<display-name>Archetype Created Web Application</display-name>
</web-app>
